close all
clear
clc

ft_path = 'D:\OS(CURRENT)\scripts\eSPoC_UMAP\0_2AOS\fieldtrip';

if ~exist('ft_defaults','file')
    addpath(ft_path);
end

ft_defaults;

%% =====================================================================
% LOAD DATA
% =====================================================================
sub_path = 'sub2_center_out_epochs.fif';

cfg = [];
cfg.dataset = sub_path;
Xinf = ft_preprocessing(cfg);    % Load EEG/MEG data
Fs = Xinf.fsample;               % Sampling frequency

% Initialize topography structure
topo = [];
topo.dimord = 'chan_time';
topo.label  = Xinf.elec.label;  
topo.time   = 0;
topo.elec   = Xinf.elec;
topo.time    = 0;

% Prepare FieldTrip layout for topography plotting
laycfg = [];
laycfg.elec = Xinf.elec;
lay = ft_prepare_layout(laycfg);     

cfg.marker       = 'labels';
cfg.layout       = lay;
cfg.comment      = 'no';
cfg.style        = 'fill';
cfg.markersymbol = 'o';
cfg.colorbar     = 'yes'; 

%%
[b,a] = butter(3,[8,12]/(Fs/2)); 

Ws = 0.2;
Ss = 0.1;

X_epochs = [];
Z_epochs = [];

X_raw_filt = [];
Z_raw = [];

for i=1:numel(Xinf.trial)
    i
    Trial = Xinf.trial{i};

    Trial_filt = filtfilt(b,a,Trial(1:38,:)')';
    
    Trial_eeg_filt = Trial_filt(:,Fs/2:end-Fs/2);
    Trial_var = Trial(39:end,Fs/2:end-Fs/2);
    
    X_raw_filt = cat(2, X_raw_filt, Trial_eeg_filt);
    Z_raw = cat(2, Z_raw, Trial_var);

    X_epochs = cat(3, X_epochs, epoch_data(Trial_eeg_filt',Fs,Ws,Ss));
    Z_epochs = cat(3, Z_epochs, epoch_data(Trial_var',Fs,Ws,Ss));
end
[~, n_chs, n_epochs] = size(epoch_data(Trial_eeg_filt',Fs,Ws,Ss));

size(X_raw_filt)
size(Z_raw)

size(X_epochs)
size(Z_epochs)

%%
velocity_chs = 6:8;
Z = squeeze(mean(Z_epochs(:,velocity_chs,:).^2, 1));
Z = mean(Z,1);

% [We, Ae, Vf, Vz, corrs_espoc, Feat, Epochs_cov, eigenvalues] = espoc(X_epochs, Z);
[W, A, Vf, corrs, Feat, Epochs_cov, eigenvalues] = espoc_r2(X_epochs, Z);

[Ws, As] = spoc(X_epochs, Z);
Env = [];
for local_src_idx=1:size(W,2)
    for ep_idx=1:size(Epochs_cov,3)
        Env(ep_idx) = W(:,local_src_idx)' * Epochs_cov(:,:,ep_idx) * W(:,local_src_idx);
    end
    corrs_spoc(local_src_idx)=corr(Env',Z');
end

figure;stem(corrs'); hold on
stem(corrs_spoc')

%%
lcl_src_idx = 1;

wx = We(:,lcl_src_idx)';
ax = Ae(:,lcl_src_idx)';

[~, idx] = max(abs(wx));
wx = wx .* sign(wx(idx));
[~, idx] = max(abs(ax));
ax = ax .* sign(ax(idx));

figure
set(gcf,'Color','w');
t = tiledlayout(1,2, 'TileSpacing','compact', 'Padding','compact');

% --- Filter
ax1 = nexttile(t, 1); 
title(ax1,'Filter');
topo.avg   = wx;
cfg.figure = ax1;
ft_topoplotER(cfg, topo); 

% --- Pattern
ax1 = nexttile(t, 2); 
title(ax1,'Pattern');
topo.avg   = ax;
cfg.figure = ax1;
ft_topoplotER(cfg, topo); 

%%
lcl_src_idx = 1;

wx = We(:,lcl_src_idx);
ax = Ae(:,lcl_src_idx);

[~, idx] = max(abs(wx));
wx = wx .* sign(wx(idx));
[~, idx] = max(abs(ax));
ax = ax .* sign(ax(idx));

Component = wx'*X_raw_filt;
Comp_env = abs(hilbert(Component));

Comp_env = reshape(Comp_env, [], numel(Xinf.trial));


figure;
imagesc(Comp_env')
colorbar

%%


